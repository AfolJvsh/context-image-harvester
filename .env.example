# Optional but recommended for broad coverage.
PEXELS_API_KEY=
SERPAPI_API_KEY=

# Hard ceiling for SerpApi requests per run.
SERPAPI_MAX_SEARCHES=110

# Wikimedia asks automated clients to identify themselves with contact info.
# Replace this with your own repository URL/email before heavy usage.
WIKIMEDIA_USER_AGENT=ContextImageHarvester/1.0 (https://github.com/YOUR_USER/context-image-harvester; contact via GitHub)
