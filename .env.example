# Optional providers. The harvester can run with a subset, but fewer providers may leave items short.
PEXELS_API_KEY=
SERPAPI_API_KEY=

# Hard ceiling for paid SerpApi searches across a run/resume chain.
SERPAPI_MAX_SEARCHES=110

# Wikimedia asks automated clients to identify themselves with contact information.
WIKIMEDIA_USER_AGENT=ContextImageHarvester/1.0 (https://github.com/AfolJvsh/context-image-harvester; contact via GitHub)
